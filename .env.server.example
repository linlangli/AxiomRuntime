AI_GATEWAY_IMAGE=axiomruntime:local
AI_GATEWAY_CONFIG_ROOT=/opt/AxiomRuntime/config
AI_GATEWAY_SECRETS_ROOT=/opt/AxiomRuntime/secrets
AI_GATEWAY_WORKSPACE_ROOT=/opt/AxiomRuntime/workspaces
AI_GATEWAY_PORT=8020
AI_GATEWAY_UPSTREAM_HEADERS_TIMEOUT_MS=45000
AI_GATEWAY_AGENT_MAX_CONCURRENT_RUNS=1
AI_GATEWAY_AGENT_TIMEOUT_MS=600000
AI_GATEWAY_API_CPUS=1.5
AI_GATEWAY_API_CPU_SHARES=256
AI_GATEWAY_API_MEMORY=2g
AI_GATEWAY_API_PIDS=256
AI_GATEWAY_TELEGRAM_CPUS=1.0
AI_GATEWAY_TELEGRAM_CPU_SHARES=256
AI_GATEWAY_TELEGRAM_MEMORY=1536m
AI_GATEWAY_TELEGRAM_PIDS=256
AI_GATEWAY_LOG_MAX_SIZE=10m
AI_GATEWAY_LOG_MAX_FILES=3

# Enable only after the existing Telegram polling processes have been stopped.
# The supervisor starts every bot configured under config/telegram/bots/*.json.
# COMPOSE_PROFILES=telegram
