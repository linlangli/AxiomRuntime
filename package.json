{
  "name": "ai-gateway",
  "version": "0.1.0",
  "description": "Local AI provider gateway for Claude Code and Codex CLI.",
  "type": "module",
  "bin": {
    "ai": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --enable-source-maps dist/cli/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "release": "node scripts/release.js",
    "prepublishOnly": "npm test"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
