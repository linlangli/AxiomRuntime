{
  "name": "@offerpilot/axiomruntime",
  "version": "0.0.6",
  "description": "CLI-first foundation for an enterprise AI Runtime with provider routing and governed execution.",
  "homepage": "https://github.com/linlangli/AxiomRuntime",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linlangli/AxiomRuntime.git"
  },
  "bugs": {
    "url": "https://github.com/linlangli/AxiomRuntime/issues"
  },
  "type": "module",
  "bin": {
    "ai": "./dist/cli/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc && npm run build:web:console && chmod +x dist/cli/index.js",
    "build:web:console": "npm --prefix web run build:console",
    "build:web:portal": "npm --prefix web run build:portal",
    "dev": "node --enable-source-maps dist/cli/index.js",
    "server": "node --enable-source-maps dist/server/index.js",
    "telegram:service": "node --enable-source-maps dist/telegram/supervisor.js",
    "test": "npm run build && node --test test/*.test.js",
    "release": "node scripts/release.js",
    "release:current": "node scripts/release.js --npm",
    "release:check": "npm test && npm pack --dry-run",
    "homebrew:update": "node scripts/update-homebrew-formula.js --write",
    "homebrew:check": "node scripts/update-homebrew-formula.js",
    "homebrew:publish": "node scripts/release.js --homebrew",
    "prepublishOnly": "npm run release:check"
  },
  "files": [
    "dist",
    "docs/USAGE.html",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ssh2": "^1.15.6",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "gpt-tokenizer": "^3.4.0",
    "grammy": "^1.44.0",
    "https-proxy-agent": "^9.1.0",
    "image-size": "2.0.4",
    "proper-lockfile": "^4.1.2",
    "ssh2": "^1.17.0",
    "undici": "^8.10.0"
  }
}
